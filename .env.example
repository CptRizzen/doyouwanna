# Expo public env (safe to ship in the client bundle — anon key is RLS-guarded).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (Supabase Edge Function secrets — never expose in the app):
#   supabase secrets set RESEND_API_KEY=...
#   supabase secrets set PUBLIC_APP_URL=https://doyouwanna.app
